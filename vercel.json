{
  "version": 2,
  "builds": [
    {
      "src": "prophets/src/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "prophets/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "prophets/src/main.py"
    },
    {
      "src": "/chart.min.js",
      "dest": "prophets/static/chart.min.js"
    },
    {
      "src": "/(.*)",
      "dest": "prophets/static/$1"
    }
  ]
}
