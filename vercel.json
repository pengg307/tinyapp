{
  "version": 2,
  "builds": [
    {
      "src": "career_course/src/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "career_course/src/main.py"
    },
    {
      "src": "/health",
      "dest": "career_course/src/main.py"
    },
    {
      "src": "/",
      "dest": "career_course/static/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "career_course/static/$1"
    }
  ]
}
